---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Main from "@/components/Main.astro";
import Footer from "@/components/Footer.astro";
import { BLUEPRINTS } from "@/data/blueprints";
import config from "@/config";
---

<Layout
  title={`Blueprints | ${config.site.title}`}
  description="Free production Docker Compose stacks, .env.example templates, and cost-modeling CSV calculators from every CodeToCost episode."
>
  <Header />
  <Breadcrumb />
  <Main
    pageTitle="Production Blueprints"
    pageDesc="Every CodeToCost episode ships with a deployable Docker Compose stack, hardened .env.example, and CSV cost calculator."
  >
    <div class="grid grid-cols-1 gap-5">
      {
        BLUEPRINTS.map(bp => (
          <article class="border-border bg-muted/20 hover:border-accent/60 rounded-lg border p-5 transition-colors sm:p-6">
            <div class="flex flex-wrap items-center justify-between gap-2">
              <div class="flex items-center gap-2">
                <span class="bg-accent/15 text-accent rounded px-2 py-0.5 font-mono text-xs font-semibold">
                  EP {String(bp.episode).padStart(2, "0")}
                </span>
                <span class="text-emerald font-mono text-xs font-semibold">
                  {bp.estimatedSavings}
                </span>
              </div>
              <div class="flex flex-wrap gap-1.5">
                {bp.stack.map(tech => (
                  <span class="border-border bg-background text-muted-foreground rounded border px-2 py-0.5 font-mono text-[11px]">
                    {tech}
                  </span>
                ))}
              </div>
            </div>

            <h2 class="text-foreground mt-3 text-xl font-semibold">
              <a
                href={`/blueprints/${bp.slug}`}
                class="hover:text-accent transition-colors"
              >
                {bp.title}
              </a>
            </h2>

            <p class="text-muted-foreground mt-2 text-sm leading-relaxed">
              {bp.summary}
            </p>

            <div class="mt-4 flex flex-wrap items-center gap-4">
              <a
                href={`/blueprints/${bp.slug}`}
                class="bg-accent text-accent-foreground hover:bg-accent/90 inline-flex items-center gap-1.5 rounded-md px-3.5 py-2 text-sm font-semibold transition-colors"
              >
                Get Blueprint →
              </a>
              <a
                href={`/posts/${bp.postSlug}`}
                class="text-muted-foreground hover:text-accent text-sm font-medium underline decoration-dashed underline-offset-4"
              >
                Read Episode {String(bp.episode).padStart(2, "0")} Analysis
              </a>
            </div>
          </article>
        ))
      }
    </div>
  </Main>
  <Footer />
</Layout>
