---
import { getCollection } from "astro:content";
import type { GetStaticPathsOptions } from "astro";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Main from "@/components/Main.astro";
import Card from "@/components/Card.astro";
import Pagination from "@/components/Pagination.astro";
import Footer from "@/components/Footer.astro";
import { PILLARS, type PillarMeta } from "@/data/pillars";
import { getSortedPosts } from "@/utils/getSortedPosts";
import config from "@/config";

export async function getStaticPaths({ paginate }: GetStaticPathsOptions) {
  const posts = await getCollection("posts", ({ data }) => !data.draft);

  return PILLARS.flatMap(pillarMeta => {
    const pillarPosts = getSortedPosts(
      posts.filter(({ data }) => data.pillar === pillarMeta.slug)
    );

    return paginate(pillarPosts, {
      params: { pillar: pillarMeta.slug },
      props: { pillarMeta },
      pageSize: config.posts.perPage,
    });
  });
}

const { page, pillarMeta } = Astro.props as {
  page: import("astro").Page<import("astro:content").CollectionEntry<"posts">>;
  pillarMeta: PillarMeta;
};
---

<Layout
  title={`${pillarMeta.name} | ${config.site.title}`}
  description={pillarMeta.description}
>
  <Header />
  <Breadcrumb />
  <Main pageTitle={pillarMeta.name} pageDesc={pillarMeta.description}>
    {
      page.data.length > 0 ? (
        <ul class="grid grid-cols-1 gap-4 md:grid-cols-2">
          {page.data.map(data => (
            <Card {...data} />
          ))}
        </ul>
      ) : (
        <p class="text-muted-foreground text-sm">
          No analyses published in this pillar yet. Check back soon.
        </p>
      )
    }
  </Main>
  <Pagination {page} />
  <Footer noMarginTop={page.lastPage > 1} />
</Layout>
