---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Main from "@/components/Main.astro";
import Footer from "@/components/Footer.astro";
import { PILLARS } from "@/data/pillars";
import config from "@/config";
---

<Layout title={`Pillars | ${config.site.title}`}>
  <Header />
  <Breadcrumb />
  <Main
    pageTitle="Editorial Pillars"
    pageDesc="Browse CodeToCost analyses by architectural and economic focus."
  >
    <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
      {
        PILLARS.map(pillar => (
          <a
            href={`/pillars/${pillar.slug}`}
            class="group border-border bg-muted/20 hover:border-accent/60 flex flex-col justify-between rounded-lg border p-5 transition-colors"
          >
            <div>
              <span class="text-accent font-mono text-xs font-medium">
                /{pillar.slug}
              </span>
              <h2 class="text-foreground group-hover:text-accent mt-1.5 text-lg font-semibold transition-colors">
                {pillar.name}
              </h2>
              <p class="text-muted-foreground mt-1.5 text-sm">
                {pillar.description}
              </p>
            </div>
            <span class="text-accent mt-4 inline-flex items-center gap-1 text-xs font-semibold">
              View analyses →
            </span>
          </a>
        ))
      }
    </div>
  </Main>
  <Footer />
</Layout>
